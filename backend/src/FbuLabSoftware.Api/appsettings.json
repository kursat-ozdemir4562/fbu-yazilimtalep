{
  "Database": {
    "Provider": "Npgsql",
    "AutoMigrate": false
  },
  "Jwt": {
    "Issuer": "FbuLabSoftware",
    "Audience": "FbuLabSoftware.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RememberMeRefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "Saml": {
    "PublicOrigin": "",
    "IdpEntityId": "https://sts.windows.net/dc718077-bfeb-4008-8a36-f0633b36a83e/"
  },
  "Ldap": {
    "Host": "",
    "Port": 636,
    "BindDn": "",
    "AcademicOu": "",
    "AdministrativeOu": "",
    "SyncIntervalHours": 12
  },
  "Smtp": {
    "Username": "",
    "Password": ""
  },
  "Uploads": {
    "AbsoluteMaxFileBytes": 52428800
  },
  "Reports": {
    "MaxRows": 100000
  },
  "RateLimit": {
    "PermitLimit": 100
  },
  "Swagger": {
    "Enabled": false
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "RequireHeaderSymmetry": true,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
